generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (values are lowercase so they match the frontend types directly)
// ---------------------------------------------------------------------------

enum Role {
  user
  seller
  admin
  super_admin
}

enum UserStatus {
  active
  suspended
}

enum BookStatus {
  draft
  pending
  published
  rejected
  archived
}

enum Currency {
  USD
  KHR
}

enum BookFormat {
  PDF
  EPUB
}

enum OrderStatus {
  pending
  completed
  failed
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

enum ReportReason {
  copyright
  inappropriate
  spam
  misleading
  other
}

enum ReportStatus {
  open
  resolved
  dismissed
}

// ---------------------------------------------------------------------------
// Users and auth
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(191)
  passwordHash String     @db.VarChar(255)
  role         Role       @default(user)
  status       UserStatus @default(active)
  bio          String?    @db.Text
  avatarUrl    String?    @db.VarChar(500)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  author             Author?
  sessions           AuthSession[]
  resetTokens        PasswordResetToken[]
  favoriteCategories UserFavoriteCategory[]
  orders             Order[]
  library            LibraryEntry[]
  favorites          Favorite[]
  reviews            Review[]
  progress           ReadingProgress[]
  bookmarks          Bookmark[]
  notifications      Notification[]
  reportsFiled       Report[]               @relation("ReportReporter")
  reportsHandled     Report[]               @relation("ReportHandler")
  auditLogs          AuditLog[]
  pendingUploads     PendingUpload[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// Database-backed sessions. The browser only holds an httpOnly cookie with a
// random token; we store the SHA-256 hash of that token here.
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  userAgent String?  @db.VarChar(255)
  ip        String?  @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Seller / author profile (one per user who became a seller).
// CHANGED: instagram and x columns replace the old socialLinks JSON.
model Author {
  id                String    @id @default(cuid())
  userId            String    @unique
  displayName       String    @db.VarChar(120)
  bio               String?   @db.Text
  avatarUrl         String?   @db.VarChar(500)
  websiteUrl        String?   @db.VarChar(500)
  instagram         String?   @db.VarChar(255)
  x                 String?   @db.VarChar(255)
  rightsConfirmedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  books Book[]

  @@map("authors")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books       Book[]
  favoritedBy UserFavoriteCategory[]

  @@map("categories")
}

model UserFavoriteCategory {
  userId     String
  categoryId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@map("user_favorite_categories")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique @db.VarChar(60)
  books BookTag[]

  @@map("tags")
}

// CHANGED: downloads counter added.
model Book {
  id                String      @id @default(cuid())
  authorId          String
  categoryId        String?
  title             String      @db.VarChar(255)
  subtitle          String?     @db.VarChar(255)
  description       String?     @db.Text
  coverUrl          String?     @db.VarChar(500)
  price             Decimal     @default(0) @db.Decimal(12, 2)
  compareAtPrice    Decimal?    @db.Decimal(12, 2)
  currency          Currency    @default(USD)
  language          String      @default("English") @db.VarChar(50)
  format            BookFormat?
  pages             Int?
  status            BookStatus  @default(draft)
  rejectionReason   String?     @db.Text
  rightsBasis       String?     @db.VarChar(255)
  rightsDetails     String?     @db.Text
  rightsConfirmedAt DateTime?
  views             Int         @default(0)
  downloads         Int         @default(0)
  ratingAvg         Decimal     @default(0) @db.Decimal(3, 2)
  ratingCount       Int         @default(0)
  publishedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  author     Author            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category   Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  file       BookFile?
  previews   BookPreview[]
  tags       BookTag[]
  orderItems OrderItem[]
  library    LibraryEntry[]
  favorites  Favorite[]
  reviews    Review[]
  progress   ReadingProgress[]
  bookmarks  Bookmark[]
  reports    Report[]

  @@index([status])
  @@index([authorId])
  @@index([categoryId])
  @@index([publishedAt])
  @@map("books")
}

model BookTag {
  bookId String
  tagId  String

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
  @@map("book_tags")
}

// The actual e-book file. Only the storage key lives here; the file itself is
// stored on disk locally and in Cloudflare R2 in production.
model BookFile {
  id           String     @id @default(cuid())
  bookId       String     @unique
  storageKey   String     @db.VarChar(500)
  originalName String     @db.VarChar(255)
  mimeType     String     @db.VarChar(100)
  sizeBytes    Int
  format       BookFormat
  createdAt    DateTime   @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("book_files")
}

model BookPreview {
  id       String  @id @default(cuid())
  bookId   String
  position Int
  title    String? @db.VarChar(255)
  content  String  @db.LongText

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, position])
  @@map("book_previews")
}

// ---------------------------------------------------------------------------
// Commerce (order and payment fields are still provisional)
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique @db.VarChar(32) // e.g. EB-2026-000001
  userId      String
  status      OrderStatus @default(pending)
  totalAmount Decimal     @db.Decimal(12, 2)
  currency    Currency    @default(USD)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  bookId    String
  price     Decimal  @db.Decimal(12, 2)
  currency  Currency @default(USD)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([bookId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  provider    String        @db.VarChar(40) // "mock" now, "aba_payway" in Phase 15
  providerRef String?       @db.VarChar(120)
  status      PaymentStatus @default(pending)
  amount      Decimal       @db.Decimal(12, 2)
  currency    Currency      @default(USD)
  rawResponse Json?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Reader data
// ---------------------------------------------------------------------------

model LibraryEntry {
  id          String   @id @default(cuid())
  userId      String
  bookId      String
  purchasedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("library_entries")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("favorites")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  rating    Int // 1 to 5
  title     String?  @db.VarChar(160)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("reviews")
}

model ReadingProgress {
  id         String   @id @default(cuid())
  userId     String
  bookId     String
  percent    Int      @default(0) // 0 to 100
  chapter    String   @default("") @db.VarChar(160)
  position   Int      @default(0)
  lastReadAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("reading_progress")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  label     String   @db.VarChar(160)
  position  Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
  @@map("bookmarks")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(160)
  body      String?   @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Moderation
// ---------------------------------------------------------------------------

model Report {
  id          String       @id @default(cuid())
  bookId      String
  reporterId  String?
  reason      ReportReason
  details     String       @db.Text
  status      ReportStatus @default(open)
  resolution  String?      @db.Text
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime     @default(now())

  book      Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  reporter  User? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  handledBy User? @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([status])
  @@map("reports")
}

// CHANGED: matches the frontend AuditEntry (targetLabel required, detail text).
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String   @db.VarChar(120)
  action      String   @db.VarChar(60) // e.g. book.approve, user.suspend
  targetType  String   @db.VarChar(40) // book | user | category | report
  targetId    String   @db.VarChar(191)
  targetLabel String   @db.VarChar(255)
  detail      String?  @db.Text
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// Files a seller uploaded that are not attached to a book yet.
// They expire after 24 hours if the book is never submitted.
model PendingUpload {
  id           String   @id @default(cuid())
  userId       String
  kind         String   @db.VarChar(10) // "book" or "cover"
  storageKey   String   @db.VarChar(100) // file name inside storage/tmp
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  sizeBytes    Int
  format       String   @db.VarChar(10) // pdf | epub | jpg | png | webp
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("pending_uploads")
}